package com.btc.TaskManagement.repository;

import com.btc.TaskManagement.model.Order;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface OrderRepositoryJPA extends JpaRepository<Order, Long> {

    // Kullanıcı adına göre siparişleri getirir
    List<Order> findByUser_Username(String username);

    // Kullanıcı ID'sine göre siparişleri getirir (Spring Data JPA sorguyu otomatik türetir)
    List<Order> findByUser_Id(Long userId);

}
