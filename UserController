package com.btc.TaskManagement.controller;

import com.btc.TaskManagement.model.User;
import com.btc.TaskManagement.service.UserService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.math.BigDecimal;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api")
@CrossOrigin(origins = "*")
public class UserController {

    @Autowired(required = false)
    private UserService userService;

    // ==========================================
    // 1. KULLANICI LİSTELEME VE YÖNETİMİ
    // ==========================================

    @GetMapping("/users")
    public ResponseEntity<?> getAllUsers() {
        if (userService != null) {
            try {
                List<User> users = userService.getAllUsers();
                return ResponseEntity.ok(users);
            } catch (Exception e) {
                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                        .body("Kullanıcılar getirilemedi: " + e.getMessage());
            }
        }
        return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE).body("UserService devredışı.");
    }

    @PostMapping("/users/add")
    public ResponseEntity<?> addUser(@RequestBody User user) {
        if (userService != null && user != null) {
            try {
                // Güncelleme İşlemi (ID Varsa)
                if (user.getId() != null) {
                    User existingUser = userService.getUserById(user.getId());
                    if (existingUser != null) {
                        if (user.getUsername() != null && !user.getUsername().trim().isEmpty()) {
                            existingUser.setUsername(user.getUsername().trim());
                        }
                        if (user.getPassword() != null && !user.getPassword().trim().isEmpty()) {
                            existingUser.setPassword(encryptPassword(user.getPassword().trim()));
                        }
                        if (user.getBalance() != null) {
                            existingUser.setBalance(user.getBalance());
                        }
                        userService.updateUser(existingUser);
                        return ResponseEntity.ok(existingUser);
                    }
                }

                // Yeni Ekleme İşlemi
                if (user.getPassword() != null && !user.getPassword().trim().isEmpty()) {
                    user.setPassword(encryptPassword(user.getPassword().trim()));
                }

                User savedUser = userService.saveUser(user);
                return ResponseEntity.status(HttpStatus.CREATED).body(savedUser);
            } catch (Exception e) {
                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                        .body("Kullanıcı kaydedilemedi: " + e.getMessage());
            }
        }
        return ResponseEntity.badRequest().body("Geçersiz kullanıcı verisi!");
    }

    @DeleteMapping("/users/delete/{id}")
    public ResponseEntity<?> deleteUser(@PathVariable Long id) {
        if (userService != null) {
            try {
                userService.deleteUser(id);
                return ResponseEntity.ok("Kullanıcı başarıyla silindi.");
            } catch (Exception e) {
                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Silme işlemi başarısız!");
            }
        }
        return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE).body("UserService devredışı.");
    }

    // ==========================================
    // 2. GİRİŞ VE BAKİYE İŞLEMLERİ
    // ==========================================

    @PostMapping("/login")
    public ResponseEntity<User> checkLogin(@RequestBody Map<String, String> payload) {
        String username = payload.get("username");
        String plainPassword = payload.get("password");

        if (username == null || plainPassword == null) {
            return ResponseEntity.status(HttpStatus.FORBIDDEN).build();
        }

        username = username.trim();
        plainPassword = plainPassword.trim();

        if (userService != null) {
            try {
                User user = userService.getUserByUsername(username);

                if (user != null) {
                    String encryptedInputPassword = encryptPassword(plainPassword);
                    String dbPassword = user.getPassword();

                    if (dbPassword != null && (dbPassword.equals(encryptedInputPassword) || dbPassword.equals(plainPassword))) {
                        return ResponseEntity.ok(user);
                    }
                }
            } catch (Exception e) {
                System.out.println(">>> Sorgulama hatası: " + e.getMessage());
            }
        }

        // Test Kullanıcısı Fallback
        if ("admin".equalsIgnoreCase(username) && "12345".equals(plainPassword)) {
            User testUser = new User();
            testUser.setId(1L);
            testUser.setUsername("admin");
            testUser.setName("admin");
            testUser.setBalance(BigDecimal.valueOf(100000));
            return ResponseEntity.ok(testUser);
        }

        return ResponseEntity.status(HttpStatus.FORBIDDEN).build();
    }

    @GetMapping("/user/{username}")
    public ResponseEntity<User> getUserByUsername(@PathVariable String username) {
        if (userService != null && username != null && !username.trim().isEmpty()) {
            try {
                User user = userService.getUserByUsername(username.trim());
                if (user != null) {
                    return ResponseEntity.ok(user);
                }
            } catch (Exception e) {
                System.out.println(">>> Kullanıcı getirme hatası: " + e.getMessage());
            }
        }

        if ("admin".equalsIgnoreCase(username)) {
            User testUser = new User();
            testUser.setId(1L);
            testUser.setUsername("admin");
            testUser.setName("admin");
            testUser.setBalance(BigDecimal.valueOf(100000));
            return ResponseEntity.ok(testUser);
        }

        return ResponseEntity.notFound().build();
    }

    @PostMapping("/update-balance")
    public ResponseEntity<String> updateBalance(@RequestBody Map<String, Object> payload) {
        String username = (String) payload.get("username");
        Object userIdObj = payload.get("userId");
        Object balanceObj = payload.get("balance");

        if (balanceObj == null) {
            return ResponseEntity.badRequest().body("Bakiye bilgisi eksik!");
        }

        BigDecimal newBalance;
        try {
            newBalance = new BigDecimal(balanceObj.toString());
        } catch (Exception e) {
            return ResponseEntity.badRequest().body("Geçersiz bakiye formatı!");
        }

        if (userService != null) {
            try {
                User user = null;
                if (username != null && !username.trim().isEmpty()) {
                    user = userService.getUserByUsername(username.trim());
                }
                if (user == null && userIdObj != null) {
                    Long userId = Long.parseLong(userIdObj.toString());
                    user = userService.getUserById(userId);
                }

                if (user != null) {
                    user.setBalance(newBalance);
                    userService.updateUser(user);
                    return ResponseEntity.ok("Bakiye başarıyla güncellendi.");
                }
            } catch (Exception e) {
                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                        .body("Güncelleme hatası: " + e.getMessage());
            }
        }

        return ResponseEntity.ok("Bakiye güncelleme simüle edildi.");
    }

    private String encryptPassword(String password) {
        try {
            MessageDigest md = MessageDigest.getInstance("MD5");
            byte[] hashedBytes = md.digest(password.getBytes());

            StringBuilder sb = new StringBuilder();
            for (byte b : hashedBytes) {
                sb.append(String.format("%02x", b));
            }
            return sb.toString();
        } catch (NoSuchAlgorithmException e) {
            throw new RuntimeException("Şifreleme algoritması bulunamadı!", e);
        }
    }
}
